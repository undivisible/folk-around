{
  "name": "folk-around-signal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WRANGLER_SEND_METRICS=false wrangler dev",
    "build": "astro build",
    "deploy": "bun run build && WRANGLER_SEND_METRICS=false wrangler deploy",
    "tail": "WRANGLER_SEND_METRICS=false wrangler tail",
    "format": "prettier --plugin=prettier-plugin-astro --check src/**/*.ts src/**/*.astro package.json tsconfig.json astro.config.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "itty-router": "^5.0.24"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/bun": "^1.3.14",
    "astro": "7.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "sharp": "0.35.3",
    "svgo": "4.0.2"
  }
}
