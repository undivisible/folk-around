---
const healthUrl = "/health";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Folk Around signalling helps local MCP agents discover peers and exchange connection messages."
    />
    <title>Folk Around Signalling</title>
    <style>
      :root {
        color-scheme: dark;
        --bg: #101211;
        --panel: #171b19;
        --panel-strong: #202622;
        --ink: #f0f0ea;
        --muted: #a8b0a8;
        --line: #3b443d;
        --accent: #8fcf93;
        --accent-strong: #d3f36b;
        --warn: #f1bf60;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(
            circle at 15% 10%,
            rgba(143, 207, 147, 0.16),
            transparent 28rem
          ),
          linear-gradient(
              135deg,
              rgba(255, 255, 255, 0.035) 25%,
              transparent 25%
            )
            0 0 / 18px 18px,
          var(--bg);
        color: var(--ink);
        font-family:
          ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
          "Liberation Mono", monospace;
      }

      main {
        min-height: 100vh;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.8fr);
        gap: clamp(2rem, 5vw, 5.5rem);
        align-items: center;
        width: min(1120px, calc(100% - 2rem));
        margin: 0 auto;
        padding: 5rem 0;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        min-height: 2.25rem;
        padding: 0 0.85rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(23, 27, 25, 0.8);
        color: var(--muted);
        font-size: 0.82rem;
      }

      .status-dot {
        width: 0.62rem;
        height: 0.62rem;
        border-radius: 50%;
        background: var(--warn);
        box-shadow: 0 0 0 0 rgba(241, 191, 96, 0.4);
      }

      .status-dot[data-state="ok"] {
        background: var(--accent);
        box-shadow: 0 0 0 0.42rem rgba(143, 207, 147, 0.11);
      }

      h1 {
        max-width: 11ch;
        margin: 1.35rem 0 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(4rem, 11vw, 8.5rem);
        font-weight: 500;
        line-height: 0.84;
        letter-spacing: 0;
      }

      .blurb {
        max-width: 43rem;
        margin: 1.4rem 0 0;
        color: var(--muted);
        font-size: clamp(1.03rem, 1.4vw, 1.22rem);
        line-height: 1.7;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        margin-top: 2rem;
      }

      a {
        color: inherit;
      }

      .button {
        min-height: 2.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 1rem;
        border: 1px solid var(--line);
        border-radius: 0.5rem;
        background: var(--panel-strong);
        color: var(--ink);
        text-decoration: none;
      }

      .button.primary {
        border-color: transparent;
        background: var(--accent-strong);
        color: #121511;
      }

      .console {
        border: 1px solid var(--line);
        border-radius: 0.5rem;
        background: rgba(14, 17, 15, 0.9);
        box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.32);
        overflow: hidden;
      }

      .console-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 3.1rem;
        padding: 0 1rem;
        border-bottom: 1px solid var(--line);
        background: var(--panel);
        color: var(--muted);
        font-size: 0.82rem;
      }

      .node-map {
        position: relative;
        aspect-ratio: 1.12;
        min-height: 320px;
        background:
          linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 42px 42px,
          linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 42px
            42px;
      }

      .node-map::before,
      .node-map::after {
        content: "";
        position: absolute;
        inset: 20%;
        border: 1px solid rgba(143, 207, 147, 0.36);
        border-radius: 50%;
      }

      .node-map::after {
        inset: 33%;
        border-color: rgba(211, 243, 107, 0.42);
      }

      .node {
        position: absolute;
        display: grid;
        place-items: center;
        width: 5.2rem;
        height: 5.2rem;
        border: 1px solid var(--line);
        border-radius: 50%;
        background: var(--panel-strong);
        color: var(--ink);
        font-size: 0.78rem;
        text-align: center;
      }

      .node.local {
        left: 12%;
        bottom: 17%;
      }

      .node.room {
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        border-color: var(--accent-strong);
      }

      .node.peer {
        right: 11%;
        top: 16%;
      }

      .wire {
        position: absolute;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          var(--accent),
          transparent
        );
        transform-origin: left center;
      }

      .wire.one {
        width: 43%;
        left: 24%;
        bottom: 38%;
        transform: rotate(-22deg);
      }

      .wire.two {
        width: 37%;
        left: 50%;
        top: 46%;
        transform: rotate(-31deg);
      }

      .meta {
        display: grid;
        gap: 0.6rem;
        padding: 1rem;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.82rem;
      }

      .meta span {
        color: var(--ink);
      }

      @media (max-width: 820px) {
        main {
          grid-template-columns: 1fr;
          padding: 3rem 0;
        }

        h1 {
          font-size: clamp(3.3rem, 18vw, 5.6rem);
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section>
        <div class="eyebrow" aria-live="polite">
          <span class="status-dot" id="status-dot"></span>
          <span id="status-text">checking signalling status</span>
        </div>
        <h1>Folk Around Signalling</h1>
        <p class="blurb">
          A tiny Cloudflare relay for Folk Around. It lets local MCP agents join
          a pairing room, find peers, and exchange offer, answer, and relay
          messages without exposing the computer-control daemon directly.
        </p>
        <div class="actions">
          <a class="button primary" href={healthUrl}>Health JSON</a>
          <a class="button" href="/rooms">Rooms API</a>
        </div>
      </section>
      <section class="console" aria-label="Signalling topology">
        <div class="console-head">
          <span>/signal/:room</span>
          <span>WebSocket</span>
        </div>
        <div class="node-map">
          <div class="wire one"></div>
          <div class="wire two"></div>
          <div class="node local">local<br />daemon</div>
          <div class="node room">room<br />DO</div>
          <div class="node peer">remote<br />peer</div>
        </div>
        <div class="meta">
          <div><span>service</span> folk-around-signal</div>
          <div><span>runtime</span> Cloudflare Workers + Durable Objects</div>
          <div>
            <span>scope</span> discovery and signalling, not a hosted MCP daemon
          </div>
        </div>
      </section>
    </main>
    <script>
      const dot = document.getElementById("status-dot");
      const text = document.getElementById("status-text");

      fetch("/health")
        .then((response) => {
          if (!response.ok) throw new Error("health failed");
          return response.json();
        })
        .then((health) => {
          if (health.ok) {
            dot?.setAttribute("data-state", "ok");
            if (text) text.textContent = "signalling service online";
          }
        })
        .catch(() => {
          if (text) text.textContent = "status unavailable";
        });
    </script>
  </body>
</html>
